# Railway sets PORT automatically. Do not hard-code it in Railway variables.
SITE_ORIGIN=https://xfthxfth.dpdns.org
PORT=3000
NODE_ENV=production

# Required for database migrations and application data.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Required by the independent admin panel session layer.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Legacy Manus OAuth values are optional and are not needed for admin login.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_API_URL=
MANUS_API_KEY=

# ImageKit storage for wallpaper and logo uploads.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/xwqxnxqle
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Optional platform/admin settings.
OWNER_OPEN_ID=
ADMIN_EMAILS=
GOOGLE_AI_STUDIO_API_KEY=
